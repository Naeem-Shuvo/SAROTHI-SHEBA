# ══════════════════════════════════════════════════════════════════
# SAROTHI SHEBA — backend environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored. NEVER commit it.
# If a secret ever reaches a commit, ignoring the file afterwards does
# nothing — git history is permanent. It must be purged from history AND
# rotated at the source. See ULTIMATE_REFINEMENT_PLAN.md §1.3 (P0-3).
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=4000

# ── Auth ──────────────────────────────────────────────────────────
# Generate a fresh one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Anyone holding this can forge a token for any user id and any role.
JWT_SECRET=

# ── Admin bootstrap ───────────────────────────────────────────────
# ⚠️ DEPRECATED — removed in Phase 5.
# These are currently the ENTIRE admin authorization check
# (backend/controller/register.js:82-88), so whoever knows the string
# becomes an admin. Replaced by a seeded bootstrap admin + invite flow.
ADMIN_LEVEL1=
ADMIN_LEVEL2=

# ── PostgreSQL ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
# Required. The server refuses to start without it — there is deliberately
# no default, so a typo fails loudly here instead of confusingly later.
PG_PASSWORD=

# ── SSLCommerz payment gateway ────────────────────────────────────
# Sandbox credentials: https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 'true' = sandbox. Anything else = LIVE. Note the inverted sense in
# backend/controller/payment.js:7 — `is_live = SSLCOMMERZ_IS_SANDBOX !== 'true'`
SSLCOMMERZ_IS_SANDBOX=true

# ── URLs ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
